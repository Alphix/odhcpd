#!/usr/bin/env python3
"""odhcpd network lab: see LAB.md.

usage: tests/lab build [--clean] [--asan] [--ref NAME=REF ...] [--only NAME ...]
       tests/lab check
       tests/lab clean [--all]
       tests/lab [--name NAME] up [--without STACK] [--require STACK] | down | status
       tests/lab [--name NAME] <node|network> shell | log [-f] | exec <cmd...>
       tests/lab [--name NAME] <odhcpd node> ubus <args...> | reload | restart | config
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from netlab import build as labbuild  # noqa: E402
from netlab.paths import WORK, RUN  # noqa: E402
from netlab.lab import Lab, LabError  # noqa: E402
from netlab.topology import NODES, NETWORKS  # noqa: E402


def cmd_build(args):
    refs = dict(r.split('=', 1) for r in args.ref)
    labbuild.build(refs=refs, clean=args.clean, sanitize=args.asan, only=args.only)


def cmd_check(args):
    missing = labbuild.check_requirements(need_pytest=True)
    if missing:
        sys.exit('missing: ' + ', '.join(missing))
    print('all requirements present; built:', 'yes' if labbuild.built() else 'no (run tests/lab build)')


def cmd_clean(args):
    target = WORK if args.all else RUN
    shutil.rmtree(target, ignore_errors=True)
    print(f'removed {target}')


def cmd_up(args):
    if not labbuild.built():
        labbuild.build()
    lab = Lab(args.name).up(without=args.without, require=args.require)
    print(lab.status())


def cmd_down(args):
    Lab(args.name).down()


def cmd_status(args):
    print(Lab(args.name).status())


USAGE_TARGET = """\
node/network commands:
  <node> shell | exec <cmd...> | log [-f]            any node (shell/exec also for networks)
  <odhcpd node> ubus <args...> | reload | restart | config
  <client node> renew | release | restart [4|6]       udhcpc (4) and/or odhcp6c (6); on the
                                                      systemd/nm nodes networkd/NetworkManager
  router wan|wan6 renew | release | restart | log     the router's uplink clients
  isp prefix-change                                   delegate from the other PD pool
  <network> capture [tcpdump args...]                 tcpdump on the network's bridge
  <node> probe [--dev DEV] dhcp6|dhcp4|rs <step>...   crafted exchanges (see netlab/probe.py)
  <node> fuzz [--dev DEV] dhcp6|dhcp4|rs <count> [seed]   mutated messages, then a health check
  clients renew | release | restart [4|6]             all client nodes (4|6: the OpenWrt ones)
  servers log [-f]                                    isp, router and relay odhcpd logs
"""


def execin(argv, env):
    os.execvpe(argv[0], argv, env)


def follow_or_print(logs, follow, tag=False):
    if not logs:
        sys.exit('tests/lab: no logs yet')
    if follow:
        os.execvp('tail', ['tail', '-n', '20', '-F'] + [str(l) for l in logs])
    for l in logs:
        print(f'==> {l.parent.name}/{l.name} <==' if tag else f'==> {l.name} <==')
        print(l.read_text(), end='')


def target_cmd(name, argv):
    """tests/lab [--name N] <node|network|group> <command> [args]"""
    lab = Lab(name)
    target, cmd, rest = argv[0], (argv[1] if len(argv) > 1 else None), argv[2:]
    kind = NODES.get(target, {}).get('kind')
    paths_env = __import__('netlab.paths').paths.env()
    if cmd is None or cmd in ('-h', '--help'):
        sys.exit(USAGE_TARGET)

    if target == 'clients':
        which = {'4': 'dhcp4', '6': 'dhcp6'}.get(rest[0]) if rest else None
        for node in lab.nodes:
            if NODES[node]['kind'] == 'client' and (not which or lab.stack(node) == 'openwrt'):
                lab.client_action(node, cmd, which)
        return
    if target == 'servers':
        if cmd != 'log':
            sys.exit(USAGE_TARGET)
        logs = [lab.dir / n / 'odhcpd.log' for n, s in NODES.items() if s['kind'] == 'odhcpd']
        return follow_or_print([l for l in logs if l.exists()], '-f' in rest, tag=True)

    lab.check_node(target)
    if cmd == 'shell':
        return lab.shell(target)
    if cmd == 'exec':
        lab.require()
        execin(lab.argv(target, rest), paths_env)
    if cmd == 'log':
        return follow_or_print(lab.logs(target), '-f' in rest)
    if target in NETWORKS:
        if cmd != 'capture':
            sys.exit(USAGE_TARGET)
        lab.require()
        # tcpdump would switch to its own user, which doesn't exist in the lab
        execin(lab.argv(target, ['tcpdump', '-Z', 'root', '-i', 'br', '-n', '-l']
                        + (rest or ['-vv'])), paths_env)

    if cmd in ('probe', 'fuzz'):
        dev = None
        if rest[:1] == ['--dev']:
            dev, rest = rest[1], rest[2:]
        if cmd == 'probe':
            if len(rest) < 2 or rest[0] not in ('dhcp6', 'dhcp4', 'rs'):
                sys.exit(USAGE_TARGET)
            for res in lab.probe(target, rest[0], rest[1:], dev=dev):
                print(json.dumps(res, indent=1))
        else:
            if len(rest) < 2:
                sys.exit(USAGE_TARGET)
            seed = int(rest[2]) if len(rest) > 2 else 1
            print(json.dumps(lab.fuzz(target, rest[0], int(rest[1]), seed, dev=dev), indent=1))
        return
    if kind == 'odhcpd' and cmd in ('ubus', 'reload', 'restart', 'config'):
        if cmd == 'ubus':
            lab.require()
            execin(lab.argv(target, ['ubus'] + rest), paths_env)
        if cmd == 'reload':
            return lab.reload(target)
        if cmd == 'restart':
            return lab.restart(target)
        lab.require()
        cfg = lab.dir / target / 'cfg' / 'dhcp'
        editor = os.environ.get('VISUAL') or os.environ.get('EDITOR') or 'vi'
        if subprocess.run([editor, str(cfg)]).returncode == 0:
            lab.reload(target)
            print(f'{target}: odhcpd reloaded')
        return
    if target == 'isp' and cmd == 'prefix-change':
        old, new = lab.prefix_change()
        print(f'isp: PD pool {old} -> {new}')
        return
    if target == 'router' and cmd in ('wan', 'wan6'):
        if not rest:
            sys.exit(USAGE_TARGET)
        if rest[0] == 'log':
            return follow_or_print([lab.dir / 'router' / f'{cmd}.log'], '-f' in rest[1:])
        return lab.client_action('router', rest[0], cmd)
    if kind == 'client' and cmd in ('renew', 'release', 'restart'):
        which = {'4': 'dhcp4', '6': 'dhcp6'}.get(rest[0]) if rest else None
        return lab.client_action(target, cmd, which)
    sys.exit(f'tests/lab: "{cmd}" doesn\'t apply to {target}\n\n' + USAGE_TARGET)


def main():
    argv = sys.argv[1:]
    name = 'default'
    if len(argv) >= 2 and argv[0] == '--name':
        name, argv = argv[1], argv[2:]
    if argv and argv[0] in list(NODES) + NETWORKS + ['clients', 'servers']:
        try:
            return target_cmd(name, argv)
        except LabError as e:
            sys.exit(f'tests/lab: {e}')

    p = argparse.ArgumentParser(prog='tests/lab', description='odhcpd network lab (see LAB.md)')
    sub = p.add_subparsers(dest='cmd', required=True)

    u = sub.add_parser('up', help='start the lab (builds first if needed)')
    u.add_argument('--without', action='append', metavar='STACK',
                   help='don\'t use this optional client stack (systemd, nm)')
    u.add_argument('--require', action='append', metavar='STACK',
                   help='fail if this optional client stack can\'t be used')
    u.set_defaults(func=cmd_up)
    d = sub.add_parser('down', help='stop the lab (keeps its logs)')
    d.set_defaults(func=cmd_down)
    s = sub.add_parser('status', help='nodes, addresses and networks')
    s.set_defaults(func=cmd_status)

    b = sub.add_parser('build', help='build everything the lab needs into the work directory')
    b.add_argument('--clean', action='store_true', help='rebuild from scratch (keeps downloads)')
    b.add_argument('--asan', action='store_true', help='build odhcpd with ASan/UBSan')
    b.add_argument('--ref', action='append', default=[], metavar='NAME=REF',
                   help='pin a dependency to a git ref, e.g. libubox=<sha>')
    b.add_argument('--only', action='append', metavar='NAME', help='build only this component')
    b.set_defaults(func=cmd_build)

    c = sub.add_parser('check', help='check the requirements from the distribution')
    c.set_defaults(func=cmd_check)

    cl = sub.add_parser('clean', help='remove lab run state (--all: the whole work directory)')
    cl.add_argument('--all', action='store_true')
    cl.set_defaults(func=cmd_clean)

    args = p.parse_args(argv)
    args.name = name
    try:
        args.func(args)
    except RuntimeError as e:
        sys.exit(f'tests/lab: {e}')


if __name__ == '__main__':
    main()
